<% layout("layouts/boilerplate") -%>
<body>
    <div class="row ">
        <div class="col-8 offset-2 mt-4">
            <h1>Log in Wanderlust</h1>
            <form method="POST" action="/login" class="needs-validation" novalidate>
                <div class="mb-3">
                    <lable for="username" class="form-label">Username</lable>
                    <input name="username" type="text" class="form-control" id="username" required>
                    <div class="invalid-feedback">Enter a Unique Username</div>
                </div>
                <div class="mb-3">
                    <lable for="password" class="form-label">Password</lable>
                    <input name="password" type="password" class="form-control" id="password" required>
                    <div class="invalid-feedback">Password shouldbe valid</div>
                </div>
                <div class="btns mt-3">
                    <form method="POST" action="/login">
                        <button class="btn btn-success ">Login</button>
                    </form>
                    <form method="GET" action="/signup">
                        <button class="btn btn-dark add-btn">Signup</button>
                    </form>
                    <div>
                        New user?
                    </div>
                </div>
            </form>
        </div>
    </div>    
</body>
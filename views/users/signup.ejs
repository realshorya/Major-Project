<% layout("layouts/boilerplate") -%>
<body>
    <div class="row">
        <div class="col-8 offset-2 mt-4">
            <h1>Sign up Wanderlust</h1>
            <form method="POST" action="/signup" class="needs-validation" novalidate>
                <div class="mb-3">
                    <lable for="username" class="form-label">Username</lable>
                    <input name="user[username]" type="text" class="form-control" id="username" required>
                    <div class="invalid-feedback">Enter a Unique Username</div>
                </div>
                <div class="mb-3">
                    <lable for="email" class="form-label">Email</lable>
                    <input name="user[email]" type="text" class="form-control" id="email" required>
                    <div class="invalid-feedback">Email should be valid</div>
                </div>
                <div class="mb-3">
                    <lable for="password" class="form-label">Password</lable>
                    <input name="user[password]" type="password" class="form-control" id="password" required>
                    <div class="invalid-feedback">Password shouldbe valid</div>
                </div>
                <div class="btns mt-3">
                    <form method="POST" action="/signup">
                        <button class="btn btn-success">Signup</button>
                    </form>
                    <form method="GET" action="/login">
                        <button class="btn btn-dark add-btn">Login</button>
                    </form>
                    <div>
                        Existing user?
                    </div>
                </div>
            </form>
        </div>
    </div>    
</body>
<% layout("layouts/boilerplate") -%>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <h1>New Listing</h1>
            <form method="POST" action="/listings" enctype="multipart/form-data" class="needs-validation" novalidate>
                <div class="mb-3">
                    <lable for="title" class="form-label">Title</lable>
                    <input placeholder="Enter property name" name="listing[title]" type="text" class="form-control" required>
                    <div class="invalid-feedback">Title should be valid</div>
                </div>
                <div class="mb-3">
                    <lable for="description" class="form-label">Description</lable>
                    <textarea placeholder="Property description" name="listing[description]" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please enter a short description</div>
                </div>
                <div class="row">
                    <div class="mb-3 col-md-8">
                        <lable for="image" class="form-label">UploadImage</lable>
                        <input name="listing[image]" type="file" class="form-control" required>
                        <div class="invalid-feedback">Image should be valid</div>
                    </div>
                    <div class="mb-3 col-md-4">
                        <lable for="image" class="form-label">Category</lable>
                        <select class="form-select" aria-label="Default select example" name="listing[category]" required>
                            <option value="" disabled selected>Select Category</option>
                            <option value="rooms">Rooms</option>
                            <option value="iconic-cities">Iconic Cities</option>
                            <option value="mountains">Mountains</option>
                            <option value="castles">Castles</option>
                            <option value="amazing-pools">Amazing Pools</option>
                            <option value="camping">Camping</option>
                            <option value="farms">Farms</option>
                            <option value="arctic">Arctic</option>
                            <option value="domes">Domes</option>
                            <option value="boats">Boats</option>
                            <option value="beach">Beach</option>
                        </select>
                        <div class="invalid-feedback">Category should be valid</div>
                    </div>
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                    <lable for="price" class="form-label">Price</lable>
                        <input placeholder="eg. 999" name="listing[price]" class="form-control" required>
                        <div class="invalid-feedback">Price should be valid</div>
                    </div>
                    <div class="mb-3 col-md-8">
                        <lable for="location" class="form-label">Location</lable>
                        <input placeholder="eg. New Delhi" name="listing[location]" type="text" class="form-control" required>
                        <div class="invalid-feedback">Location should be valid</div>
                    </div>
                </div>
                <div class="mb-3">
                        <lable for="country" class="form-label">Country</lable>
                        <input placeholder="eg. India" name="listing[country]" type="text" class="form-control" required>
                        <div class="invalid-feedback">Country should be valid</div>
                </div><br>
                <button class="btn btn-dark add-btn">Add new property</button>
                <br><br><br>
            </form>
        </div>
    </div>
</body>
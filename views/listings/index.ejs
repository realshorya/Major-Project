<% layout("layouts/boilerplate") -%>
<body>
    <% const categories = [
        { name: "Rooms",key: "rooms", icon: "fa-bed" },
        { name: "Iconic Cities",key: "iconic-cities", icon: "fa-mountain-city" },
        { name: "Mountains",key: "mountains", icon: "fa-mountain" },
        { name: "Castles",key: "castles", icon: "fa-dungeon" },
        { name: "Amazing Pools",key: "amazing-pools", icon: "fa-person-swimming" },
        { name: "Camping",key: "camping", icon: "fa-tent" },
        { name: "Farms",key: "farms", icon: "fa-building-wheat" },
        { name: "Arctic",key: "arctic", icon: "fa-snowflake" },
        { name: "Domes",key: "domes", icon: "fa-igloo" },
        { name: "Boats",key: "boats", icon: "fa-ship" },
        { name: "Beach",key: "beach", icon: "fa-umbrella-beach" }
    ]; %>
    <div class="filters">
        <a href="/listings/trending">
        <div class="filter">
            <i class="fa-solid fa-fire"></i>
            <p>Trending</p>
        </div></a>
        <% for(category of categories) { %>
            <a href="/listings/filter?listingCategory=<%= category.key %>">
            <div class="filter">
                <i class="fa-solid <%= category.icon %>"></i>
                <p><%= category.name %></p>
            </div>
        </a>
        <% } %>
        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
            </div>
        </div>
    </div> 
    <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for(listing of listings){ %>
            <a href="/listings/<%= listing.id %>" class="listing-link">
                <div class="card col listing-card" style="width: 18rem;">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.image.filename %>" style="height:20rem;">
                    <div class="card-img-overlay">
                        <h5 class="card-title"></h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">
                            <b><%= listing.title %></b><br>

                            ₹<span class="price" data-price="<%= listing.price %>">
                            <%= listing.price.toLocaleString("en-IN") %>
                            </span> / night

                            <i class="tax-info" style="display: none;">&nbsp; &nbsp; +18% GST</i>
                        </p>
                    </div>
                </div>
            </a>
        <% } %>
    </div>
</body>